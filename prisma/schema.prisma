// Prisma schema for 공연 예약 웹

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleType {
  USER
  STAFF
  ADMIN
  SUPER_ADMIN
}

// 입금 대기 → 예매 완료 → (환불 요청) 환불 대기 → 환불 완료. 입금 대기에서 취소·만료로 끝날 수 있다.
enum ReservationStatus {
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  REVOKED
}

// 공연 상태. 판매 중(ON_SALE)은 한 번에 하나만 둔다.
enum ShowStatus {
  DRAFT // 준비 중: 어디에도 보이지 않는다
  ON_SALE // 판매 중: 첫 화면·공연 안내·예매에 나온다
  ENDED // 지난 공연: 지난 공연 목록에 나온다
}

enum RefundStatus {
  PENDING
  REFUNDED
}

model User {
  id        String   @id @default(cuid())
  kakaoId   String?  @unique
  name      String?
  nickname  String?
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles        UserRole[]
  reservations Reservation[]
  auditLogs    AuditLog[]    @relation("AuditUser")
  credential   Credential?
}

model Role {
  id        String     @id @default(cuid())
  type      RoleType   @unique
  userRoles UserRole[]
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, isActive])
  @@index([userId, isActive, expiresAt])
}

// 공연 한 편. 화면 문구와 상태는 관리자 페이지 '공연 관리'(/admin/shows)에서 바꾼다.
model Show {
  id             String     @id @default(cuid())
  title          String
  posterUrl      String?
  dateLabel      String     @default("")
  timeLabel      String     @default("")
  timeSubLabel   String     @default("")
  venue          String     @default("")
  venueAddress   String     @default("")
  contactName    String     @default("")
  contactTag     String     @default("")
  audienceInfo   String     @default("")
  notice         String     @default("")
  price          Int        @default(0)
  paymentBank    String     @default("")
  paymentAccount String     @default("")
  paymentHolder  String     @default("")
  refundContact  String     @default("")
  // 빈 줄로 칸을 나누고, 칸의 첫 줄이 "# "로 시작하면 굵은 제목으로 보인다.
  introText      String     @default("")
  salesText      String     @default("")
  // 크레딧(공연자 명단). 한 줄에 "파트: 이름, 이름". 예매할 때 관심 있는 공연자를 이 명단에서 고른다.
  credits        String     @default("")
  // 셋리스트와 곡별 크레딧. [{ name: "1부", songs: [{ title, artist, lineup: [{ role, names }] }] }]
  setlist        Json       @default("[]")
  // 판매 중에도 셋리스트를 보여 줄지. 지난 공연은 늘 보여 준다.
  setlistPublic  Boolean    @default(false)
  // 티켓 오픈 일시. 비워 두면 판매 중으로 바꾸는 즉시 예매를 받는다.
  salesOpenAt    DateTime?
  // 예매 후 이 시간 안에 입금하지 않으면 예매가 만료된다. 0이면 공연 시작 때까지 기다린다.
  paymentHours   Int        @default(24)
  status         ShowStatus @default(DRAFT)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions ShowSession[]
}

model ShowSession {
  id            String   @id @default(cuid())
  showId        String
  title         String
  date          DateTime
  totalCapacity Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  show         Show          @relation(fields: [showId], references: [id])
  reservations Reservation[]
}

model Reservation {
  id                     String            @id @default(cuid())
  userId                 String
  sessionId              String
  qty                    Int
  preferredPerformerName String            @default("없음")
  // 통장에 찍힐 입금자명(관람객 실명). 입금 확인과 입장 확인에 쓴다.
  depositorName          String            @default("")
  status                 ReservationStatus @default(PAYMENT_PENDING)
  // 입금 기한. 지나면 EXPIRED로 바뀌고 좌석이 풀린다.
  expiresAt              DateTime
  // 운영진이 취소했을 때 사유. 관객이 직접 취소하면 빈 값이다.
  cancelReason           String            @default("")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  session ShowSession @relation(fields: [sessionId], references: [id])
  ticket  Ticket?
  refund  Refund?

  @@index([userId, createdAt])
  @@index([createdAt, id])
  @@index([status, expiresAt])
}

model Ticket {
  id            String       @id @default(cuid())
  reservationId String       @unique
  qrToken       String       @unique
  status        TicketStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  checkIn     CheckIn?

  @@index([reservationId, status, createdAt])
}

model CheckIn {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

model Refund {
  id            String       @id @default(cuid())
  reservationId String       @unique
  status        RefundStatus @default(PENDING)
  // 관객이 환불을 요청할 때 적은 계좌. 송금을 마치면(환불 완료) 계좌번호는 끝 네 자리만 남긴다.
  refundBank    String       @default("")
  refundAccount String       @default("")
  refundHolder  String       @default("")
  createdAt     DateTime     @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
}

// 누가 언제 무엇을 했는지. 관리자 > 작업 기록에서 본다. 예매에 관한 기록은 entityType "Reservation", entityId = 예매 id로 남긴다.
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  actorUserId String?
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  actorUser User? @relation("AuditUser", fields: [actorUserId], references: [id])

  @@index([createdAt])
  // 로그인 실패 횟수 세기(action = LOGIN_FAILED, entityId = 아이디)
  @@index([action, entityId, createdAt])
}

model Credential {
  id                String    @id @default(cuid())
  userId            String    @unique
  // 소문자로 저장한다(로그인할 때도 소문자로 바꿔 찾는다).
  username          String    @unique
  passwordHash      String
  // 비밀번호를 마지막으로 바꾼 때. 그 전에 받은 로그인 토큰은 더 쓰지 못한다.
  passwordChangedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 관리자가 올린 이미지(포스터). /api/assets/{id}로 내려준다.
// Vercel은 서버에 파일을 저장할 수 없어서 DB에 담는다. 포스터 몇 장이면 용량 걱정은 없다.
model Asset {
  id        String   @id @default(cuid())
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
