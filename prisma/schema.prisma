// Prisma schema for 공연 예약 웹

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleType {
  USER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum ReservationStatus {
  REQUESTED
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUND_REQUESTED
  REFUND_PENDING
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  REVOKED
}

enum RefundStatus {
  REQUESTED
  PENDING
  REFUNDED
}

model User {
  id        String   @id @default(cuid())
  kakaoId   String?  @unique
  name      String?
  nickname  String?
  email     String?  @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles        UserRole[]
  reservations Reservation[]
  auditLogs    AuditLog[]    @relation("AuditUser")
  credential   Credential?
}

model Role {
  id        String     @id @default(cuid())
  type      RoleType   @unique
  userRoles UserRole[]
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, isActive])
  @@index([userId, isActive, expiresAt])
}

// 공연 한 편. isActive인 공연 중 가장 최근에 만든 것이 홈·예매 화면에 나온다.
// 화면 문구는 관리자 페이지(/admin/show)에서 바꾼다.
model Show {
  id             String   @id @default(cuid())
  title          String
  posterUrl      String?
  dateLabel      String   @default("")
  timeLabel      String   @default("")
  timeSubLabel   String   @default("")
  venue          String   @default("")
  venueAddress   String   @default("")
  contactName    String   @default("")
  contactTag     String   @default("")
  audienceInfo   String   @default("")
  notice         String   @default("")
  price          Int      @default(0)
  paymentBank    String   @default("")
  paymentAccount String   @default("")
  paymentHolder  String   @default("")
  refundContact  String   @default("")
  // 빈 줄로 칸을 나누고, 칸의 첫 줄이 "# "로 시작하면 굵은 제목으로 보인다.
  introText      String   @default("")
  salesText      String   @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions ShowSession[]
}

model ShowSession {
  id            String   @id @default(cuid())
  showId        String
  title         String
  date          DateTime
  totalCapacity Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  show         Show          @relation(fields: [showId], references: [id])
  reservations Reservation[]
}

model Reservation {
  id                     String            @id @default(cuid())
  userId                 String
  sessionId              String
  qty                    Int
  preferredPerformerName String            @default("없음")
  status                 ReservationStatus @default(REQUESTED)
  expiresAt              DateTime
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  session ShowSession @relation(fields: [sessionId], references: [id])
  ticket  Ticket?
  refund  Refund?

  @@index([userId, createdAt])
  @@index([createdAt, id])
}

model Ticket {
  id            String       @id @default(cuid())
  reservationId String       @unique
  qrToken       String       @unique
  status        TicketStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  checkIn     CheckIn?

  @@index([reservationId, status, createdAt])
}

model CheckIn {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

model Refund {
  id            String       @id @default(cuid())
  reservationId String       @unique
  status        RefundStatus @default(REQUESTED)
  createdAt     DateTime     @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  actorUserId String?
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  actorUser User? @relation("AuditUser", fields: [actorUserId], references: [id])
}

model Credential {
  id           String @id @default(cuid())
  userId       String @unique
  username     String @unique
  passwordHash String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
