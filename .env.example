# Database (Supabase > Connect > Connection string)
# 앱은 트랜잭션 풀러(6543), 마이그레이션은 세션 연결(5432)을 쓴다.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# 서비스 주소 (끝에 / 없이). 카카오 Redirect URI는 이 주소 + /api/auth/kakao/callback
APP_URL=https://www.band-bansong.life

# 로그인 토큰 서명 키. 32자 이상 무작위 문자열 (예: openssl rand -base64 48)
JWT_SECRET=

# Kakao OAuth (developers.kakao.com > 내 애플리케이션)
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
# 카카오 콘솔의 로그아웃 Redirect URI에 등록해야 한다
KAKAO_LOGOUT_REDIRECT_URI=https://www.band-bansong.life/login

# npm run prisma:seed 때만 쓴다. 관리자 계정을 만든다(비밀번호 10자 이상). 배포 환경변수에는 넣지 않아도 된다.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
