# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# App URL (no trailing slash)
NEXTAUTH_URL=https://www.band-bansong.life
NEXTAUTH_SECRET=replace-with-strong-random-secret

# Kakao OAuth
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

# Must be registered in Kakao developer console
KAKAO_LOGOUT_REDIRECT_URI=https://www.band-bansong.life/login

# Optional: set if one Kakao account should become super admin by kakao id
SUPER_ADMIN_KAKAO_ID=replace-with-kakao-user-id

# Public payment account text shown to users
PUBLIC_PAYMENT_ACCOUNT=은행명 계좌번호 예금주
